#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/venv/bin/activate"
cd "$SCRIPT_DIR"

OPTIONS=(
  "Practice Duolingo"
  "Practice Vocabulary"
  "Installation"
  "Exit"
)

current=0

draw_menu() {
  clear
  echo "=== Duo Teacher Menu ==="
  echo
  for i in "${!OPTIONS[@]}"; do
    if [[ $i -eq $current ]]; then
      printf " > %s\n" "${OPTIONS[$i]}"
    else
      printf "   %s\n" "${OPTIONS[$i]}"
    fi
  done
}

while true; do
  draw_menu

  # read 3 chars max without echo (-s), no newline (-n3)
  IFS= read -rsn1 key
  if [[ $key == $'\x1b' ]]; then
    # possible arrow key: read the next two chars
    read -rsn2 key
    case "$key" in
      "[A") # up
        ((current--))
        if (( current < 0 )); then current=$((${#OPTIONS[@]} - 1)); fi
        ;;
      "[B") # down
        ((current++))
        if (( current >= ${#OPTIONS[@]} )); then current=0; fi
        ;;
	esac
	elif [[ $key == "" ]]; then
    case $current in
      0)

        # Start server in background as a module
        python3 -u -m app.server 2>&1 &
        server_pid=$!

        # Give the server a moment to fail fast (e.g. port already in use)
        sleep 1
        if ! kill -0 "$server_pid" 2>/dev/null; then
          echo -e "\nServer failed to start. Exiting."
          deactivate
          exit 1
        fi

        python3 -u -m daemon.main 2>&1 --test_mode &
        daemon_pid=$!

        echo -e "\n"
        echo "Server started with PID $server_pid"
        echo "Daemon started with PID $daemon_pid"
        echo -e "\nINFO: You can inspect the process by running fg <pid> in a separate terminal session.\n"

        # Open Duolingo in a dedicated Firefox profile/instance
        firefox -P duoteacher --no-remote "https://www.duolingo.com/learn" 2>/dev/null

        ;;

      1)
        # python3 -m daemon.main
        ;;
      2)
        # Installation
        ;;
      3)
        deactivate
        echo "Exiting"
        break
        ;;
    esac

    if [[ $current -eq 0 ]]; then
      echo -e "\n"
      read -rp "Browser tab closed, press any key to exit..." -n1
      echo

      if [[ -n "${server_pid:-}" ]]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
      fi

      if [[ -n "${daemon_pid:-}" ]]; then
        kill "$daemon_pid" 2>/dev/null || true
        wait "$daemon_pid" 2>/dev/null || true
      fi

      deactivate
      break
    fi
	fi
done